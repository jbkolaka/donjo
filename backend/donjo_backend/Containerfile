# syntax=docker/dockerfile:1
# Podman Containerfile for donjo_backend (Auth service)

# ---- Build stage ----
# The SQLite driver (mattn/go-sqlite3) requires cgo, so we build with CGO
# enabled inside a Go image that ships the musl toolchain (alpine variant).
FROM golang:1.26-alpine AS build

RUN apk add --no-cache gcc musl-dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/donjo-api ./cmd/api

# ---- Runtime stage ----
# Runs the built binary in a lightweight Alpine image.
FROM alpine:3.21 AS prod

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# The binary, the SQLite migrations dir, and the entrypoint script.
COPY --from=build /out/donjo-api /app/donjo-api
COPY --from=build /src/migrations /app/migrations
COPY --from=build /src/donjo-api-entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

# Directory where uploaded profile pictures and sqlite db are stored.
RUN mkdir -p /app/uploads /app/db
VOLUME ["/app/uploads", "/app/db"]

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint"]
