# Podman Containerfile for donjo_event
FROM golang:1.26-alpine AS build

RUN apk add --no-cache gcc musl-dev

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/main ./cmd/api

FROM alpine:3.21 AS prod
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata

COPY --from=build /app/main /app/main
COPY --from=build /app/migrations /app/migrations

RUN mkdir -p /app/db
VOLUME ["/app/db"]

EXPOSE 8081
CMD ["/app/main"]
